# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys, and never paste them into chat.

# --- Notion ---------------------------------------------------------------
# Internal integration secret, created by a Notion workspace owner
# (developer portal > Build > Internal connections > API token).
NOTION_TOKEN=
# Comma-separated IDs to inspect/mirror: data source IDs (preferred), database IDs, or pages that contain databases.
# Copy the 32-character ID from the database URL.
NOTION_DATABASE_IDS=
# The Master Production data source the app mirrors and creates actions in.
NOTION_DATA_SOURCE_ID=2716e9bb-1958-81b0-a4e2-000bf0330ac3
# SAFETY: nothing writes to Notion unless BOTH of these are set to the unsafe value.
# Leave them as they are. Only Dean switches them, and never while testing.
# When false (the default), the app refuses every Notion write.
NOTION_WRITES_ENABLED=false
# When true (the default), writes are logged only and never sent.
NOTION_DRY_RUN=true
# Comma-separated client slugs. While set, live writes only happen for these clients (the two
# switches above still apply); everyone else stays a dry run. Unset = no restriction.
NOTION_LIVE_CLIENTS=dnsfilter

# --- Windsor.ai -------------------------------------------------------------
# API key from windsor.ai (Account > API key).
WINDSOR_API_KEY=
# Optional: account ID to use for the smoke test per connector. Leave blank to use the first account found.
WINDSOR_SAMPLE_ACCOUNT_LINKEDIN=
WINDSOR_SAMPLE_ACCOUNT_GOOGLE_ADS=
WINDSOR_SAMPLE_ACCOUNT_FACEBOOK=

# --- Supabase (Phase 1) ------------------------------------------------------
# Project URL: Supabase dashboard > your project > Connect (or Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts sb_publishable_). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts sb_secret_). Server-side only. Bypasses RLS, so never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- Auth (Phase 1) ----------------------------------------------------------
# Where the app runs. Sign-in links point here. Use the Vercel URL in production.
APP_URL=http://localhost:3000
# Only emails on this domain can sign in.
ALLOWED_EMAIL_DOMAIN=bordeauxandburgundy.co.uk
# Email of the first admin. Given the admin role on first login.
BOOTSTRAP_ADMIN_EMAIL=dean.steinhobel@bordeauxandburgundy.co.uk

# --- Scheduled jobs (Phase 1) ------------------------------------------------
# Shared secret the scheduler sends so only it can trigger sync routes.
CRON_SECRET=

# --- Slack: weekly reports only (Dean, 2026-10-20) -------------------------
# The Lumaux Slack app's bot token (xoxb-…, scope chat:write only). Server-side only.
SLACK_BOT_TOKEN=
# Channel ID (C…) of the reporting channel; a client's own Slack channel (Admin) overrides it.
SLACK_REPORT_CHANNEL=
# Monday posts go to Slack only when this is true; otherwise they're logged as a dry run.
SLACK_REPORTS_ENABLED=false
# Optional: client slugs (comma-separated) whose Monday posts go live, e.g. dnsfilter.
SLACK_LIVE_CLIENTS=

# --- Apify: competitor ads from the public ad libraries (Dean, 2026-10-20) ------
# B&B's Apify API token (console → Settings → API & Integrations). Server-side only; read only.
APIFY_TOKEN=
# Optional: client slugs (comma-separated) whose competitors are read, e.g. dnsfilter. Empty = every
# client with competitors on its list.
COMPETITOR_CLIENTS=

# --- Ad platform APIs, direct (Dean, 2026-10-21): campaign builds, created paused ----------
# Developer apps for Reddit Ads, LinkedIn Marketing and Microsoft Advertising. Server-side only.
# Refresh tokens come from `pnpm ads:connect reddit|linkedin|microsoft` (redirect URI
# http://localhost:8765/callback must be registered on each app). It stores them in Supabase Vault,
# which the app reads first; the *_REFRESH_TOKEN values below are only a fallback.
# SAFETY: nothing is sent unless ADS_API_WRITES_ENABLED=true AND ADS_API_DRY_RUN=false AND the
# platform is in ADS_API_PLATFORMS. Only Dean switches them. ADS_API_LIVE_CLIENTS (slugs) narrows
# live writes to those clients.
ADS_API_WRITES_ENABLED=false
ADS_API_DRY_RUN=true
ADS_API_PLATFORMS=
ADS_API_LIVE_CLIENTS=
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_ADS_REFRESH_TOKEN=
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
LINKEDIN_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
# "common" (any Microsoft account), or B&B's tenant ID
MICROSOFT_ADS_TENANT_ID=common
# The secret's Value, not its Secret ID
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_REFRESH_TOKEN=
# Set after connecting: the customer (manager) and account IDs the app works in.
MICROSOFT_ADS_CUSTOMER_ID=

# --- HubSpot (later phase, stubbed) ------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=

# Claude (Anthropic API): sprint recommendations and the paid media news chat. Server-side only.
ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to a workspace: the workspace ID (wrkspc_...) from console.anthropic.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Bot protection on sign-in (optional; docs/security.md). Cloudflare Turnstile's site key is public by
# design; its secret key goes in Supabase (Auth → Bot and abuse protection), never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Show "Continue with Google" on the login page once the Google provider is set up in Supabase
GOOGLE_SIGNIN_ENABLED=false

# Email magic links on the login page (off while Google is the way in; needs a proper email sender)
EMAIL_SIGNIN_ENABLED=false

# --- Context bank (Claude Code only, never the app) -------------------------
# The Lumaux context bank's own Supabase project (context-bank/schema.sql), used by
# `pnpm context` and the lumaux-context / save-context skills. Not the Lumaux database.
CONTEXT_SUPABASE_URL=
CONTEXT_SUPABASE_SECRET_KEY=
