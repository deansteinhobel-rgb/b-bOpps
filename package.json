{
  "name": "bb-account-ops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "inspect:notion": "tsx --env-file=.env.local scripts/notion-inspect.ts",
    "inspect:windsor": "tsx --env-file=.env.local scripts/windsor-inspect.ts",
    "scan:conversions": "tsx --env-file=.env.local scripts/windsor-conversion-scan.ts",
    "test:db": "node supabase/tests/rls-check.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "sync:windsor": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-windsor.ts",
    "test": "vitest run",
    "sync:notion": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-notion.ts",
    "sync:creatives": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-creatives.ts",
    "seed:history": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/seed-history.ts",
    "fetch:logos": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/fetch-logos.ts",
    "upload:font": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/upload-font.ts",
    "sync:hq": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-hq.ts",
    "sync:breakdowns": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-breakdowns.ts",
    "dev:signin": "tsx --env-file=.env.local scripts/dev-signin.ts",
    "sync:changes": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-changes.ts",
    "ideas:content": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/content-ideas.ts",
    "sync:calls": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/sync-calls.ts",
    "label": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local scripts/label.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@base-ui/react": "^1.8.0",
    "@notionhq/client": "^5.26.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.2"
  },
  "version": "0.1.0"
}
